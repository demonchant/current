{
  "name": "current",
  "compatibility_date": "2026-11-04",
  "main": "./worker/index.js",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      { "name": "RELAY_JOBS", "class_name": "RelayJob" },
      { "name": "PAYMENT_CLAIMS", "class_name": "PaymentClaims" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayJob", "PaymentClaims"] }
  ]
}
